/*
  Copy this file to arduino_secrets.h and fill in your own values.
  arduino_secrets.h is gitignored.
*/

#define SECRET_SSID "YourWiFiSSID"
#define SECRET_PASS "YourWiFiPassword"

/*
  Where the board fetches its update image from.

  This lives here rather than in the sketch because it is specific to your
  machine, not to the pattern. tools/serve.py prints the exact URL to paste.

  Plain HTTP keeps the first attempt simple. HTTPS works, but it needs a
  valid cacert.pem in QSPI partition 1 - add TLS once HTTP is proven.
*/
#define SECRET_OTA_URL "http://192.168.1.100:8000/UPDATE.ota"
